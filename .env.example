# Modelo de variaveis de ambiente. Copie para ".env" e preencha.
# O .env real NUNCA deve ser commitado (ja esta no .gitignore).

# Senha do banco de dados do Supabase (uso administrativo, fora do site)
SENHA_BD_SUPABASE=

# Chave da API OpenRouter — usada APENAS no secret da Edge Function 'ai-chat',
# nunca no front-end. Configure no Supabase com:
#   supabase secrets set OPENROUTER_API_KEY=sua_chave_aqui
SENHA_API_OPENROUTER=
